# Copy to .env — never commit the real file (see .gitignore).
# Zero values here may ever overlap with the Infrakinetic api-server's .env
# (README.md hard rule #3) — verified by diff, not assumed.

GOVERNANCE_API_HOST=127.0.0.1
GOVERNANCE_API_PORT=4100

# 1A.2 — dedicated Cognito operator pool ("polynovea-platform-operators").
# PENDING: this pool does not exist yet (AWS provisioning requires separate
# authorization — see docs/1A.2_status.md). The server boots and /healthz
# passes with these unset; only a request under /management/v1/* needs them,
# and fails closed with IDENTITY_PROVIDER_MISCONFIGURED (500) if missing.
# No default is provided here on purpose — there is no safe placeholder
# region/pool/client id that wouldn't look like a real one.
GOVERNANCE_COGNITO_REGION=
GOVERNANCE_COGNITO_USER_POOL_ID=
GOVERNANCE_COGNITO_APP_CLIENT_ID=
# Optional overrides — leave unset in every real environment; derived from
# region+pool above. Only meaningful for local/manual testing against a
# non-Cognito JWKS endpoint.
GOVERNANCE_COGNITO_ISSUER=
GOVERNANCE_COGNITO_JWKS_URI=
GOVERNANCE_MANAGEMENT_TOKEN_CLOCK_TOLERANCE_SEC=5

# 1A.3 — dedicated Governance Postgres database (`polynovea_governance`),
# on the SAME RDS instance as Infrakinetic but a SEPARATE database (never
# `polynoveacrm`) — see backend/provisioning/README.md and
# docs/1A.3_status.md "Architecture correction". PENDING: this
# database/role does not exist yet. The server boots and /healthz passes
# with these unset; only a /management/v1/* request that reaches the
# operator directory or session store needs them, and fails closed with
# GOVERNANCE_DB_UNAVAILABLE (503) if missing. No default is provided here
# on purpose, same reasoning as the Cognito section above. This must never
# be the same host+database+role as Infrakinetic's api-server database
# (README.md hard rule #2) — HOST may legitimately match (same RDS
# instance), NAME/USER/PASSWORD must not.
GOVERNANCE_DB_HOST=
GOVERNANCE_DB_PORT=5432
GOVERNANCE_DB_NAME=
GOVERNANCE_DB_USER=
GOVERNANCE_DB_PASSWORD=
# Defaults to true (encrypted). Set to "false" only for local development
# against a Postgres instance with no TLS configured — never in a real
# environment. rejectUnauthorized is always true when SSL is on (see
# pgDbClient.ts) — it is never weakened to false here.
# Trusted CA bundle for real certificate verification (e.g. the Amazon RDS
# combined CA bundle — see backend/certs/rds-ca-global-bundle.pem, committed
# because it is public trust material, not a secret). Optional, but without
# it a real RDS endpoint's certificate cannot be verified and the connection
# fails closed rather than silently skipping verification.
GOVERNANCE_DB_SSL_CA_FILE=
# Overrides the hostname checked against the server certificate. Required
# whenever GOVERNANCE_DB_HOST is a local SSH-tunnel address (e.g. 127.0.0.1)
# rather than the real RDS DNS name the certificate was issued for.
GOVERNANCE_DB_SSL_SERVERNAME=
GOVERNANCE_DB_SSL=true
GOVERNANCE_DB_POOL_MAX=10

# 1A.4 — Management API transport. Governance mints short-lived (60-120s,
# clamped in code — see management/managementConfig.ts), RS256-signed
# assertions for Infrakinetic's /management/v1/*. GOVERNANCE_MANAGEMENT_ISSUER
# and _AUDIENCE are the exact iss/aud Infrakinetic's verifier must match —
# never a wildcard, never inferred. PENDING: not provisioned yet; only the
# JWKS endpoint (/.well-known/management-jwks.json) and actual assertion
# minting need these — server boot and /healthz never require them.
GOVERNANCE_MANAGEMENT_ISSUER=
GOVERNANCE_MANAGEMENT_AUDIENCE=
# RS256 keypair Governance signs management assertions with. The private key
# never leaves this backend (see scripts/check_no_signing_key_in_frontend.mjs)
# and is never committed. Generate with, e.g.:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out key.pem
GOVERNANCE_MANAGEMENT_SIGNING_KID=
GOVERNANCE_MANAGEMENT_SIGNING_PRIVATE_KEY_PEM=
# Optional JSON array of additional public-only JWKs still accepted for
# verification during a key rotation grace window (each entry must carry its
# own 'kid'). Leave unset outside an active rotation.
GOVERNANCE_MANAGEMENT_SIGNING_ADDITIONAL_PUBLIC_JWKS=
