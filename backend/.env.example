# Copy to .env — never commit the real file (see .gitignore).
# Zero values here may ever overlap with the Infrakinetic api-server's .env
# (README.md hard rule #3) — verified by diff, not assumed.

GOVERNANCE_API_HOST=127.0.0.1
GOVERNANCE_API_PORT=4100

# 1A.2 — dedicated Cognito operator pool ("polynovea-platform-operators").
# PENDING: this pool does not exist yet (AWS provisioning requires separate
# authorization — see docs/1A.2_status.md). The server boots and /healthz
# passes with these unset; only a request under /management/v1/* needs them,
# and fails closed with IDENTITY_PROVIDER_MISCONFIGURED (500) if missing.
# No default is provided here on purpose — there is no safe placeholder
# region/pool/client id that wouldn't look like a real one.
GOVERNANCE_COGNITO_REGION=
GOVERNANCE_COGNITO_USER_POOL_ID=
GOVERNANCE_COGNITO_APP_CLIENT_ID=
# Optional overrides — leave unset in every real environment; derived from
# region+pool above. Only meaningful for local/manual testing against a
# non-Cognito JWKS endpoint.
GOVERNANCE_COGNITO_ISSUER=
GOVERNANCE_COGNITO_JWKS_URI=
GOVERNANCE_MANAGEMENT_TOKEN_CLOCK_TOLERANCE_SEC=5

# 1A.3 — Governance Postgres connection. CORRECTED 2026-09-11: Governance
# uses the SAME existing production database as Infrakinetic (so HOST/PORT/
# NAME below are expected to match Infrakinetic's own api-server/.env
# values — that is intentional, not a hard-rule-#2 violation). Isolation is
# the dedicated `governance_app` role (created by
# backend/provisioning/001_create_role_and_schema.sql) with its own
# password and its own `governance` schema — GOVERNANCE_DB_USER/PASSWORD
# must NEVER be Infrakinetic's application role/password. PENDING: this
# role/schema does not exist yet (see backend/provisioning/README.md and
# docs/1A.3_status.md). The server boots and /healthz passes with these
# unset; only a /management/v1/* request that reaches the operator
# directory or session store needs them, and fails closed with
# GOVERNANCE_DB_UNAVAILABLE (503) if missing. No default is provided here
# on purpose, same reasoning as the Cognito section above.
GOVERNANCE_DB_HOST=
GOVERNANCE_DB_PORT=5432
GOVERNANCE_DB_NAME=
GOVERNANCE_DB_USER=
GOVERNANCE_DB_PASSWORD=
# Defaults to true (encrypted). Set to "false" only for local development
# against a Postgres instance with no TLS configured — never in a real
# environment.
GOVERNANCE_DB_SSL=true
GOVERNANCE_DB_POOL_MAX=10
